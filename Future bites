<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Future Bites — Taste The Future | AI Powered Restaurant</title>
<meta name="description" content="Future Bites — AI powered restaurant. Online order, live order tracking, deals & offers. Call 0311 4970970">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;800&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --gold:#d4af37;
  --gold-2:#f7e08a;
  --gold-3:#a67c00;
  --black:#070707;
  --dark:#111111;
  --dark-2:#181818;
  --line:rgba(212,175,55,.22);
  --txt:#e9e9e9;
  --muted:#9a9a9a;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  font-family:'Poppins',system-ui,-apple-system,sans-serif;
  background:var(--black);color:var(--txt);overflow-x:hidden;line-height:1.65;
}
h1,h2,h3,.serif{font-family:'Playfair Display',Georgia,serif}
img{max-width:100%;display:block}
a{text-decoration:none;color:inherit}
.container{width:min(1180px,92%);margin:0 auto}
.gold-text{
  background:linear-gradient(135deg,var(--gold-2),var(--gold),var(--gold-3));
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
}
.btn{
  display:inline-flex;align-items:center;gap:9px;padding:13px 30px;border-radius:50px;
  font-weight:600;font-size:.92rem;cursor:pointer;border:none;transition:.3s;letter-spacing:.4px;
  font-family:'Poppins',sans-serif;
}
.btn-gold{
  background:linear-gradient(135deg,var(--gold-2),var(--gold),var(--gold-3));
  color:#0a0a0a;box-shadow:0 8px 28px rgba(212,175,55,.3);
}
.btn-gold:hover{transform:translateY(-3px);box-shadow:0 14px 38px rgba(212,175,55,.5)}
.btn-out{
  background:transparent;color:var(--gold);border:1.5px solid var(--gold);
}
.btn-out:hover{background:var(--gold);color:#0a0a0a}

/* ===== HEADER ===== */
header{
  position:fixed;top:0;left:0;width:100%;z-index:900;
  background:rgba(7,7,7,.72);backdrop-filter:blur(16px);
  border-bottom:1px solid transparent;transition:.35s;
}
header.scrolled{background:rgba(7,7,7,.96);border-bottom-color:var(--line);box-shadow:0 10px 40px rgba(0,0,0,.6)}
.nav-wrap{display:flex;align-items:center;justify-content:space-between;padding:14px 0}
.brand{display:flex;align-items:center;gap:12px}
.brand-logo{height:52px;width:auto;object-fit:contain}
.brand-fallback{display:flex;align-items:center;gap:11px}
.logo-mark{
  width:44px;height:44px;border-radius:13px;display:grid;place-items:center;
  background:linear-gradient(135deg,#f2f2f2,#a9a9a9 45%,#ffffff 60%,#8c8c8c);
  color:#111;font-weight:800;font-family:'Playfair Display',serif;font-size:1.1rem;
  box-shadow:0 0 0 2px rgba(212,175,55,.5),0 6px 18px rgba(0,0,0,.6);
  position:relative;
}
.logo-mark::after{
  content:'';position:absolute;right:-4px;bottom:-4px;width:14px;height:14px;
  background:linear-gradient(135deg,#b6e33f,#7fae12);transform:rotate(45deg);border-radius:3px;
}
.brand-text{font-family:'Playfair Display',serif;font-weight:800;font-size:1.28rem;letter-spacing:1.5px;line-height:1}
.brand-text span{color:var(--gold)}
.brand-sub{font-size:.6rem;letter-spacing:3.5px;color:var(--muted);text-transform:uppercase}

nav{display:flex;align-items:center;gap:6px}
nav a{
  padding:9px 15px;font-size:.87rem;font-weight:500;border-radius:30px;
  transition:.25s;position:relative;color:#cfcfcf;
}
nav a:hover{color:var(--gold);background:rgba(212,175,55,.09)}
.nav-actions{display:flex;align-items:center;gap:10px}
.cart-btn{
  position:relative;background:transparent;border:1.5px solid var(--line);color:var(--gold);
  width:44px;height:44px;border-radius:50%;cursor:pointer;font-size:1.1rem;transition:.3s;
}
.cart-btn:hover{background:var(--gold);color:#0a0a0a;border-color:var(--gold)}
.cart-count{
  position:absolute;top:-5px;right:-5px;background:var(--gold);color:#0a0a0a;
  font-size:.68rem;font-weight:700;min-width:20px;height:20px;border-radius:50%;
  display:grid;place-items:center;font-family:'Poppins',sans-serif;
}
.nav-toggle{display:none;background:none;border:none;color:var(--gold);font-size:1.6rem;cursor:pointer}

/* ===== HERO ===== */
.hero{
  min-height:100vh;display:flex;align-items:center;position:relative;
  padding:130px 0 70px;overflow:hidden;
}
.hero::before{
  content:'';position:absolute;inset:0;
  background:
    radial-gradient(circle at 78% 35%,rgba(212,175,55,.17),transparent 46%),
    radial-gradient(circle at 12% 82%,rgba(212,175,55,.09),transparent 42%);
}
.hero::after{
  content:'';position:absolute;inset:0;opacity:.35;
  background-image:linear-gradient(rgba(212,175,55,.05) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(212,175,55,.05) 1px,transparent 1px);
  background-size:58px 58px;
  mask-image:radial-gradient(circle at 50% 50%,#000,transparent 78%);
  -webkit-mask-image:radial-gradient(circle at 50% 50%,#000,transparent 78%);
}
.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:1.08fr .92fr;gap:55px;align-items:center}
.pill{
  display:inline-flex;align-items:center;gap:9px;padding:7px 17px;border-radius:40px;
  border:1px solid var(--line);background:rgba(212,175,55,.07);
  font-size:.76rem;letter-spacing:1.6px;text-transform:uppercase;color:var(--gold);font-weight:500;
}
.dot{width:7px;height:7px;border-radius:50%;background:#7fae12;box-shadow:0 0 0 0 rgba(127,174,18,.7);animation:pulse 2s infinite}
@keyframes pulse{70%{box-shadow:0 0 0 9px rgba(127,174,18,0)}100%{box-shadow:0 0 0 0 rgba(127,174,18,0)}}
.hero h1{font-size:clamp(2.4rem,5.6vw,4.15rem);line-height:1.07;margin:22px 0 18px;font-weight:800}
.hero p.lead{font-size:1.05rem;color:var(--muted);max-width:540px;margin-bottom:34px}
.hero-btns{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:44px}
.hero-stats{display:flex;gap:42px;flex-wrap:wrap}
.stat b{display:block;font-size:1.75rem;font-family:'Playfair Display',serif;color:var(--gold)}
.stat span{font-size:.76rem;color:var(--muted);letter-spacing:1.4px;text-transform:uppercase}

.hero-visual{position:relative;display:grid;place-items:center}
.plate{
  width:min(430px,88vw);aspect-ratio:1;border-radius:50%;position:relative;
  background:radial-gradient(circle at 35% 30%,#242424,#0d0d0d 70%);
  border:1px solid var(--line);
  box-shadow:0 0 90px rgba(212,175,55,.22),inset 0 0 70px rgba(0,0,0,.9);
  display:grid;place-items:center;
  animation:float 6s ease-in-out infinite;
}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-16px)}}
.plate-emoji{font-size:clamp(5rem,17vw,9rem);filter:drop-shadow(0 18px 34px rgba(0,0,0,.8))}
.ring{
  position:absolute;inset:-22px;border-radius:50%;
  border:1px dashed rgba(212,175,55,.35);animation:spin 26s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg)}}
.badge-float{
  position:absolute;background:rgba(17,17,17,.92);border:1px solid var(--line);
  border-radius:15px;padding:11px 17px;backdrop-filter:blur(10px);
  box-shadow:0 14px 34px rgba(0,0,0,.65);font-size:.8rem;
}
.badge-float b{display:block;color:var(--gold);font-size:.94rem}
.badge-1{top:8%;left:-4%;animation:float 5s ease-in-out infinite}
.badge-2{bottom:11%;right:-3%;animation:float 5s ease-in-out infinite .9s}

/* ===== SECTIONS ===== */
section{padding:100px 0;position:relative}
.sec-head{text-align:center;max-width:680px;margin:0 auto 58px}
.sec-tag{font-size:.76rem;letter-spacing:4px;text-transform:uppercase;color:var(--gold);font-weight:600}
.sec-head h2{font-size:clamp(1.9rem,4vw,2.9rem);margin:12px 0 14px;font-weight:800}
.sec-head p{color:var(--muted);font-size:.98rem}

/* ABOUT */
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.about-visual{
  border-radius:26px;border:1px solid var(--line);padding:46px 30px;text-align:center;
  background:linear-gradient(160deg,#161616,#0a0a0a);
  box-shadow:inset 0 0 60px rgba(212,175,55,.06);
}
.about-visual .big{font-size:5.4rem;margin-bottom:12px}
.about-feats{display:grid;gap:20px;margin-top:28px}
.feat{display:flex;gap:16px;align-items:flex-start}
.feat-ico{
  flex:0 0 46px;height:46px;border-radius:13px;display:grid;place-items:center;font-size:1.2rem;
  background:rgba(212,175,55,.1);border:1px solid var(--line);
}
.feat h4{font-size:1rem;margin-bottom:3px;color:#fff;font-weight:600;font-family:'Poppins',sans-serif}
.feat p{font-size:.87rem;color:var(--muted)}

/* SERVICES */
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(255px,1fr));gap:24px}
.card{
  background:linear-gradient(165deg,#141414,#0b0b0b);
  border:1px solid rgba(255,255,255,.06);border-radius:20px;padding:34px 28px;
  transition:.35s;position:relative;overflow:hidden;
}
.card::before{
  content:'';position:absolute;top:0;left:0;width:100%;height:2px;
  background:linear-gradient(90deg,transparent,var(--gold),transparent);
  transform:scaleX(0);transition:.4s;
}
.card:hover{transform:translateY(-8px);border-color:var(--line);box-shadow:0 22px 50px rgba(0,0,0,.65)}
.card:hover::before{transform:scaleX(1)}
.card-ico{font-size:2.1rem;margin-bottom:16px}
.card h3{font-size:1.2rem;margin-bottom:10px;color:#fff}
.card p{font-size:.88rem;color:var(--muted)}

/* MENU */
.filters{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-bottom:40px}
.filter{
  padding:9px 22px;border-radius:40px;border:1px solid rgba(255,255,255,.1);
  background:transparent;color:#bbb;cursor:pointer;font-size:.84rem;transition:.28s;
  font-family:'Poppins',sans-serif;
}
.filter:hover{border-color:var(--gold);color:var(--gold)}
.filter.active{background:linear-gradient(135deg,var(--gold-2),var(--gold));color:#0a0a0a;border-color:transparent;font-weight:600}
.menu-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:24px}
.dish{
  background:linear-gradient(170deg,#151515,#0a0a0a);border:1px solid rgba(255,255,255,.06);
  border-radius:20px;overflow:hidden;transition:.35s;display:flex;flex-direction:column;
}
.dish:hover{transform:translateY(-7px);border-color:var(--line);box-shadow:0 20px 46px rgba(0,0,0,.7)}
.dish-img{
  height:170px;display:grid;place-items:center;font-size:4rem;
  background:radial-gradient(circle at 50% 60%,rgba(212,175,55,.14),transparent 68%),#0f0f0f;
  border-bottom:1px solid rgba(255,255,255,.05);
}
.dish-body{padding:20px;display:flex;flex-direction:column;flex:1}
.dish-cat{font-size:.68rem;letter-spacing:2px;text-transform:uppercase;color:var(--gold);font-weight:600}
.dish h4{font-size:1.05rem;margin:7px 0 6px;color:#fff;font-family:'Poppins',sans-serif;font-weight:600}
.dish p{font-size:.82rem;color:var(--muted);flex:1;margin-bottom:16px}
.dish-foot{display:flex;align-items:center;justify-content:space-between;gap:12px}
.price{font-family:'Playfair Display',serif;font-size:1.25rem;color:var(--gold);font-weight:700}
.price small{font-size:.66rem;color:var(--muted);display:block;font-family:'Poppins',sans-serif;letter-spacing:1px}
.add-btn{
  background:rgba(212,175,55,.1);border:1px solid var(--line);color:var(--gold);
  padding:9px 16px;border-radius:30px;cursor:pointer;font-size:.8rem;font-weight:600;transition:.28s;
  font-family:'Poppins',sans-serif;white-space:nowrap;
}
.add-btn:hover{background:var(--gold);color:#0a0a0a}

/* OFFERS */
.offer-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(285px,1fr));gap:24px}
.offer{
  border-radius:22px;padding:34px 28px;position:relative;overflow:hidden;
  background:linear-gradient(150deg,#1a1a1a,#0b0b0b);border:1px solid var(--line);
  transition:.35s;
}
.offer:hover{transform:translateY(-7px);box-shadow:0 24px 55px rgba(212,175,55,.16)}
.offer.hot{background:linear-gradient(150deg,rgba(212,175,55,.18),#0b0b0b);border-color:var(--gold)}
.offer-tag{
  position:absolute;top:16px;right:-34px;transform:rotate(38deg);
  background:linear-gradient(135deg,var(--gold-2),var(--gold-3));color:#111;
  font-size:.62rem;font-weight:700;padding:5px 40px;letter-spacing:1.5px;
}
.offer .off{font-family:'Playfair Display',serif;font-size:2.7rem;font-weight:800;line-height:1}
.offer h4{font-size:1.12rem;margin:10px 0 8px;color:#fff;font-family:'Poppins',sans-serif;font-weight:600}
.offer p{font-size:.85rem;color:var(--muted);margin-bottom:18px}
.code{
  display:inline-flex;align-items:center;gap:9px;border:1.5px dashed var(--gold);
  color:var(--gold);padding:9px 18px;border-radius:10px;font-weight:700;
  letter-spacing:2px;font-size:.85rem;cursor:pointer;transition:.25s;background:rgba(212,175,55,.06);
}
.code:hover{background:rgba(212,175,55,.16)}

/* TRACKING */
.track-box{
  max-width:840px;margin:0 auto;background:linear-gradient(165deg,#141414,#0a0a0a);
  border:1px solid var(--line);border-radius:26px;padding:clamp(26px,5vw,48px);
  box-shadow:0 30px 70px rgba(0,0,0,.6);
}
.track-form{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:34px}
.track-form input{
  flex:1;min-width:220px;padding:15px 22px;border-radius:50px;
  background:#0a0a0a;border:1px solid rgba(255,255,255,.12);color:#fff;
  font-family:'Poppins',sans-serif;font-size:.92rem;outline:none;transition:.3s;
}
.track-form input:focus{border-color:var(--gold);box-shadow:0 0 0 4px rgba(212,175,55,.12)}
.timeline{display:grid;gap:0}
.step{display:flex;gap:20px;position:relative;padding-bottom:30px}
.step:last-child{padding-bottom:0}
.step::before{
  content:'';position:absolute;left:17px;top:38px;bottom:0;width:2px;background:rgba(255,255,255,.1);
}
.step:last-child::before{display:none}
.step.done::before{background:linear-gradient(180deg,var(--gold),rgba(212,175,55,.3))}
.step-dot{
  flex:0 0 36px;height:36px;border-radius:50%;display:grid;place-items:center;
  background:#151515;border:2px solid rgba(255,255,255,.14);font-size:.85rem;
  transition:.4s;z-index:2;
}
.step.done .step-dot{background:linear-gradient(135deg,var(--gold-2),var(--gold));border-color:var(--gold);color:#0a0a0a}
.step.active .step-dot{box-shadow:0 0 0 6px rgba(212,175,55,.18);animation:pulse 1.8s infinite}
.step-info h5{font-size:.98rem;color:#fff;font-family:'Poppins',sans-serif;font-weight:600}
.step-info p{font-size:.82rem;color:var(--muted)}
.step.pending .step-info h5,.step.pending .step-dot{opacity:.42}
.order-meta{
  display:flex;gap:26px;flex-wrap:wrap;padding:20px 0 26px;margin-bottom:26px;
  border-bottom:1px solid rgba(255,255,255,.07);
}
.order-meta div span{font-size:.72rem;color:var(--muted);letter-spacing:1.4px;text-transform:uppercase;display:block}
.order-meta div b{color:var(--gold);font-size:.98rem}
.track-msg{text-align:center;color:var(--muted);font-size:.9rem;padding:14px 0}
.track-msg.err{color:#ff7b7b}

/* CONTACT */
.contact-grid{display:grid;grid-template-columns:1fr 1.15fr;gap:44px}
.info-card{
  background:linear-gradient(165deg,#141414,#0a0a0a);border:1px solid var(--line);
  border-radius:22px;padding:34px 30px;
}
.info-item{display:flex;gap:16px;margin-bottom:24px;align-items:flex-start}
.info-item:last-child{margin-bottom:0}
.info-ico{
  flex:0 0 46px;height:46px;border-radius:13px;display:grid;place-items:center;font-size:1.15rem;
  background:rgba(212,175,55,.1);border:1px solid var(--line);
}
.info-item h5{font-size:.72rem;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:3px;font-weight:500}
.info-item a,.info-item p{color:#fff;font-size:.95rem;font-weight:500;transition:.25s}
.info-item a:hover{color:var(--gold)}
.contact-form{
  background:linear-gradient(165deg,#141414,#0a0a0a);border:1px solid var(--line);
  border-radius:22px;padding:34px 30px;display:grid;gap:16px;
}
.contact-form input,.contact-form textarea{
  width:100%;padding:14px 20px;border-radius:13px;background:#0a0a0a;
  border:1px solid rgba(255,255,255,.1);color:#fff;font-family:'Poppins',sans-serif;
  font-size:.9rem;outline:none;transition:.3s;resize:vertical;
}
.contact-form input:focus,.contact-form textarea:focus{border-color:var(--gold);box-shadow:0 0 0 4px rgba(212,175,55,.1)}
.form-ok{color:#8fd44a;font-size:.85rem;text-align:center}

/* FOOTER */
footer{background:#050505;border-top:1px solid var(--line);padding:60px 0 26px}
.foot-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1.2fr;gap:40px;margin-bottom:44px}
.foot-grid h5{color:var(--gold);font-size:.78rem;letter-spacing:2.4px;text-transform:uppercase;margin-bottom:18px;font-weight:600}
.foot-grid p,.foot-grid a{font-size:.87rem;color:var(--muted);display:block;margin-bottom:10px;transition:.25s}
.foot-grid a:hover{color:var(--gold);transform:translateX(4px)}
.socials{display:flex;gap:11px;margin-top:16px}
.socials a{
  width:40px;height:40px;border-radius:50%;display:grid;place-items:center;
  border:1px solid var(--line);color:var(--gold);font-size:.9rem;margin:0;transition:.3s;
}
.socials a:hover{background:var(--gold);color:#0a0a0a;transform:translateY(-4px)}
.copy{text-align:center;padding-top:24px;border-top:1px solid rgba(255,255,255,.06);font-size:.8rem;color:#666}

/* CART DRAWER */
.overlay{
  position:fixed;inset:0;background:rgba(0,0,0,.75);backdrop-filter:blur(4px);
  z-index:1000;opacity:0;visibility:hidden;transition:.35s;
}
.overlay.show{opacity:1;visibility:visible}
.drawer{
  position:fixed;top:0;right:0;height:100%;width:min(420px,100%);z-index:1001;
  background:#0d0d0d;border-left:1px solid var(--line);
  transform:translateX(105%);transition:.42s cubic-bezier(.4,0,.2,1);
  display:flex;flex-direction:column;
}
.drawer.open{transform:translateX(0)}
.drawer-head{
  padding:22px 24px;border-bottom:1px solid rgba(255,255,255,.07);
  display:flex;justify-content:space-between;align-items:center;
}
.drawer-head h3{font-size:1.2rem}
.close-x{background:none;border:none;color:var(--gold);font-size:1.6rem;cursor:pointer;line-height:1}
.drawer-body{flex:1;overflow-y:auto;padding:20px 24px}
.drawer-body::-webkit-scrollbar{width:5px}
.drawer-body::-webkit-scrollbar-thumb{background:var(--gold-3);border-radius:9px}
.cart-empty{text-align:center;color:var(--muted);padding:60px 10px;font-size:.9rem}
.cart-item{
  display:flex;gap:14px;align-items:center;padding:14px 0;
  border-bottom:1px solid rgba(255,255,255,.06);
}
.cart-item .ci-ico{font-size:1.9rem}
.cart-item .ci-info{flex:1}
.cart-item h6{font-size:.9rem;color:#fff;font-weight:600;font-family:'Poppins',sans-serif}
.cart-item span{font-size:.82rem;color:var(--gold)}
.qty{display:flex;align-items:center;gap:9px}
.qty button{
  width:26px;height:26px;border-radius:7px;border:1px solid var(--line);
  background:transparent;color:var(--gold);cursor:pointer;font-size:.9rem;line-height:1;
}
.qty button:hover{background:var(--gold);color:#0a0a0a}
.qty b{font-size:.85rem;min-width:16px;text-align:center}
.drawer-foot{padding:22px 24px;border-top:1px solid rgba(255,255,255,.07);background:#0a0a0a}
.total-row{display:flex;justify-content:space-between;margin-bottom:16px;font-size:1rem}
.total-row b{color:var(--gold);font-family:'Playfair Display',serif;font-size:1.4rem}
.drawer-foot input,.drawer-foot textarea{
  width:100%;padding:12px 16px;border-radius:11px;background:#111;margin-bottom:10px;
  border:1px solid rgba(255,255,255,.1);color:#fff;font-family:'Poppins',sans-serif;font-size:.85rem;outline:none;
}
.drawer-foot input:focus,.drawer-foot textarea:focus{border-color:var(--gold)}
.drawer-foot .btn{width:100%;justify-content:center}

/* CHATBOT */
.chat-fab{
  position:fixed;bottom:26px;right:26px;z-index:990;width:62px;height:62px;border-radius:50%;
  background:linear-gradient(135deg,var(--gold-2),var(--gold),var(--gold-3));
  border:none;cursor:pointer;font-size:1.55rem;color:#0a0a0a;
